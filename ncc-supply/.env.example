# Copy to .env and fill in real values for anything other than local dev.
# Never commit .env itself (already in .gitignore).

# Path to the local SQLite database file. Defaults to ./local.db if unset.
# Ignored when DATABASE_URL is set.
DATABASE_FILE=

# A libsql:// URL for a remote/hosted database (e.g. a Turso database's URL,
# from its dashboard or `turso db show <name> --url`). Required for any
# deployment target that doesn't keep a persistent local disk (Vercel and
# most serverless hosts) — a local SQLite file does not survive there.
DATABASE_URL=

# Auth token for DATABASE_URL (e.g. `turso db tokens create <name>`).
# Required alongside DATABASE_URL for a database that needs auth.
DATABASE_AUTH_TOKEN=

# Secret used to sign/derive staff session tokens. Must be a long, random
# value in any real environment — the code refuses to start in production
# with the built-in insecure dev default.
SESSION_SECRET=

# development | test | production
NODE_ENV=

# fixture | live — which CatalogueAdapter getCatalogueAdapter() returns.
# Defaults to fixture, so the app runs with zero Shopify credentials until
# you deliberately switch it on.
CATALOGUE_ADAPTER=

# Required only when CATALOGUE_ADAPTER=live. This is the store's
# *.myshopify.com domain, NOT its custom storefront domain (e.g.
# nccwholesale.org) — check Settings > Domains in Shopify admin, or query
# shop.myshopifyDomain via the Admin API, if unsure which one to use.
SHOPIFY_STORE_DOMAIN=

# Required only when CATALOGUE_ADAPTER=live. Get one for free: in Shopify
# admin, Sales channels > Headless > Create storefront > copy the access
# token. Treat it as a secret even though it's a "public" Storefront token —
# this app only ever sends it from the server, never to the browser.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Required only when ADMIN_COMMERCE_ADAPTER=live — create a custom app in
# Shopify admin (Settings > Apps > Develop apps) with the relevant Admin API
# scopes (write_draft_orders at minimum) and copy its Admin API access token.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Required only when CUSTOMER_ACCOUNT_ADAPTER=live (Shopify doesn't support
# localhost redirect URIs, so this can't be exercised in local dev — the
# fixture adapter below covers that). From the same Headless channel as the
# Storefront token above, under the storefront's Customer Account API
# settings.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Shopify API version to target. Defaults to the current latest stable
# version — bump this each quarter rather than leaving it unset.
SHOPIFY_API_VERSION=

# fixture | live — which CustomerAccountAdapter getCustomerAccountAdapter()
# returns. Defaults to fixture, which drives a dev-only simulated Shopify
# login page (/dev/fixture-shopify-login) so the whole buyer sign-in flow is
# testable with zero Shopify credentials.
CUSTOMER_ACCOUNT_ADAPTER=

# fixture | live — which AdminCommerceAdapter getAdminCommerceAdapter()
# returns. Defaults to fixture, which fakes a Shopify Draft Order id and
# invoice URL so the whole NCC-approval → checkout flow is testable with
# zero Shopify credentials.
ADMIN_COMMERCE_ADAPTER=

# Temporary pre-launch gate (operational, not a PRD feature): every route
# except /preview-access requires this password once per browser. Defaults
# to "ncc-preview-2026" if unset. Remove this variable entirely once the
# site is ready for its real, authorized launch (CLAUDE.md — launch is never
# inferred from phase completion).
SITE_ACCESS_PASSWORD=
